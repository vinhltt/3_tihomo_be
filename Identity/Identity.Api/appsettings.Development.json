{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "IdentityDb": "Host=server.vinhltt.com;Database=identity;Username=tihomo_dev;Password=Admin@123;Port=35432"
  },
  "JwtSettings": {
    "SecretKey": "ThisIsAVerySecretKeyForJWTTokenGenerationAndValidation123456789",
    "Issuer": "https://tihomo-dev.vinhltt.com",
    "Audience": "tihomo-local",
    "AccessTokenExpirationMinutes": "60",
    "RefreshTokenExpirationDays": "30"
  },
  "GoogleAuth": {
    "ClientId": "70021805726-2m0ndfjj6kq9es08rtce36vpdmgpn5c3.apps.googleusercontent.com"
  },
  "FacebookAuth": {
    "AppId": "your-facebook-app-id-for-development",
    "AppSecret": "your-facebook-app-secret-for-development"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "Password": "Admin@123"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "tihomo",
    "Password": "Admin@123"
  },
  "Prometheus": {
    "Enabled": true,
    "MetricsPath": "/metrics"
  },
  "Serilog": {
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithExceptionDetails"
    ],
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft": "Error",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Verbose"
      }
    },
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Grafana.Loki"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Verbose",
          "outputTemplate": "[{Timestamp:u}] [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "OtelSettings": {
    "ServiceName": "TiHoMo.Identity",
    "ServiceVersion": "1.0.0",
    "ResourceAttributes": "deployment.environment=Development",
    "ExporterOtlpEndpoint": "http://localhost:4317",
    "TracesSampler": "traceidratio",
    "TracesSamplerArg": "1.0"
  }
}