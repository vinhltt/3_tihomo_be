{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "https://tihomo-dev.vinhltt.com",
    "Audience": "TiHoMo",
    "SecretKey": "ThisIsAVerySecretKeyForJWTTokenGenerationAndValidation123456789",
    "ExpirationMinutes": 60,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true
  },
  "ConnectionStrings": {
    "CoreFinanceDb": ""
  },
  "Serilog": {
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithExceptionDetails"
    ],
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft": "Error",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Verbose"
      }
    },
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Grafana.Loki"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Verbose",
          "outputTemplate": "[{Timestamp:u}] [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://loki:3100",
          "labels": [
            {
              "key": "service_name",
              "value": "CoreFinance"
            },
            {
              "key": "environment",
              "value": "Production"
            }
          ],
          "propertiesAsLabels": [
            "TraceId",
            "RequestId",
            "ConnectionId",
            "MessageType",
            "ConsumerType",
            "level"
          ],
          "restrictedToMinimumLevel": "Information"
        }
      }
    ]
  },
  "OtelSettings": {
    "ServiceName": "TiHoMo.CoreFinance",
    "ServiceVersion": "1.0.0",
    "ResourceAttributes": "deployment.environment=Production",
    "ExporterOtlpEndpoint": "http://tempo:4317",
    "TracesSampler": "traceidratio",
    "TracesSamplerArg": "1.0"
  }
}
