{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CoreFinanceDb": "Host=server.vinhltt.com;Database=corefinance;Username=tihomo_dev;Password=Admin@123;Port=35432"
  },
  "JwtSettings": {
    "Issuer": "https://tihomo-dev.vinhltt.com",
    "Audience": "tihomo-local",
    "SecretKey": "ThisIsAVerySecretKeyForJWTTokenGenerationAndValidation123456789",
    "ExpirationMinutes": 60,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true
  },
  "CorsOptions": {
    "PolicyName": "",
    "AllowedOrigins": [
      "*"
    ],
    "AllowedMethods": [
      "*"
    ],
    "AllowedHeaders": [
      "*"
    ],
    "ExposedHeaders": [
      "Token-Expired"
    ],
    "PreflightMaxAgeInMinutes": 10
  },
  "DbSettingOptions": {
    "EnableDetailedErrors": true,
    "EnableSensitiveDataLogging": true
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "tihomo",
    "Password": "Admin@123"
  },
  "Serilog": {
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithExceptionDetails"
    ],
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft": "Error",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Verbose"
      }
    },
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Grafana.Loki"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Verbose",
          "outputTemplate": "[{Timestamp:u}] [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "./Logs/Log-.json",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Information",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  },
  "OtelSettings": {
    "ServiceName": "TiHoMo.CoreFinance",
    "ServiceVersion": "1.0.0",
    "ResourceAttributes": "deployment.environment=Development",
    "ExporterOtlpEndpoint": "http://localhost:4317",
    "TracesSampler": "traceidratio",
    "TracesSamplerArg": "1.0"
  }
}